# Defaults run the whole stack offline with no API key.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
VECTOR_STORE=memory

# --- OpenAI (or any OpenAI-compatible gateway) ---
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Local Ollama ---
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# --- Postgres + pgvector ---
# VECTOR_STORE=pgvector
# DATABASE_URL=postgresql+psycopg://insight:insight@localhost:5432/insight

# --- Retrieval tuning ---
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# DENSE_TOP_K=20
# SPARSE_TOP_K=20
# RRF_K=60
# RERANK_TOP_N=6
# MIN_GROUNDING_COVERAGE=0.05
